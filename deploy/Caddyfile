# The status site is a static file tree. Caddy owns the response headers that
# GitHub Pages cannot send; the policy file owns the cache values.

status.ia.sbktechno.com {
	root * {$SBK_STATUS_ROOT:/var/lib/sbk/status/current}
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		-Server
		-X-Powered-By
	}

	header ?Content-Security-Policy "default-src 'none'; style-src 'self'; script-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"

	@https protocol https
	header @https >Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# Every response revalidates by default. Content-hashed names are immutable
	# for a year, and the heartbeat stays no-store so a cached document cannot
	# claim a state the publisher did not just send.
	header ?Cache-Control "public, max-age=600, must-revalidate"

	@hashed path_regexp \.[0-9a-f]{12,64}\.[a-z0-9]+$
	header @hashed {
		Cache-Control "public, max-age=31536000, immutable"
		match status 2xx 304
	}

	header /status.json >Cache-Control "no-store"

	file_server
}
