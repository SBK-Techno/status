PLATFORM ?= .toolchain/platform
BRAND ?= .toolchain/brand
STATUS_ROOT ?= $(CURDIR)
GO ?= go

# Post-deploy verification needs the deployed origin, so it is not in
# GATE_TARGETS. The edge serves the live document and the publisher writes it,
# so the check reads the live document's freshness and compares the pages to
# this build; it verifies no heartbeat signature.
URL ?=
VERIFY_PUBLISHED_FLAGS ?=

PLATFORM_DIR := $(abspath $(PLATFORM))
BRAND_DIR := $(abspath $(BRAND))

# The Python build reads the platform contract through platform_contract.py.
# Export the resolved checkouts so `make validate PLATFORM=...` reaches the
# scripts exactly like the default `.toolchain` symlinks do.
export PLATFORM
export PLATFORM_DIR

# The single definition of the local gate. CI runs `make validate`; neither
# workflow keeps a second list of checks. scripts/ci_contract_test.py proves
# that the workflow still delegates here and that the pinned toolchain refs
# stay full commit SHAs.
GATE_TARGETS := status-check test contract brand-check render-check artifact-check assets-check statuscheck governance-check actionlint hook hook-check lint

.PHONY: $(GATE_TARGETS) hooks brand prune toolchain-check validate verify-published artifact cls-check

# The platform owns the brand assets; this repository owns the rendered
# pages and their build-time snapshot. `-brand-only` stops genstatus from
# overwriting index.html with the template before the renderer can read the
# previous snapshot binding, which is what keeps an unchanged document
# byte-identical across rebuilds.
brand: toolchain-check
	cd "$(PLATFORM_DIR)" && $(GO) run ./cmd/genstatus -root "$(STATUS_ROOT)" -brand "$(BRAND_DIR)" -brand-only
	$(MAKE) --no-print-directory render
	$(MAKE) --no-print-directory prune

toolchain-check:
	bash scripts/require_checkout.sh platform "$(PLATFORM_DIR)" .toolchain/platform
	bash scripts/require_checkout.sh brand "$(BRAND_DIR)" .toolchain/brand

status-check:
	python3 scripts/validate_status.py --root "$(STATUS_ROOT)"

test:
	cd "$(STATUS_ROOT)" && python3 -m unittest discover -s scripts -p '*_test.py'

# The contract target names the workflow/Makefile contract test explicitly.
# `test` discovers the same file as part of the full suite; the gate lists it
# so a failure is reported as the contract check, not as one line of 90 tests.
contract:
	python3 scripts/ci_contract_test.py

# The generated governance files are rendered by SBK-Techno/platform. This
# repository holds no copy of the generator: the check runs that source from
# the pinned checkout and compares the four files byte for byte. The pin has
# one owner, the platform `ref` in .github/actions/toolchain/action.yml.
governance-check: toolchain-check
	python3 scripts/check_governance.py --platform "$(PLATFORM_DIR)"

# A workflow GitHub rejects is discovered only when GitHub runs it. `go run`
# proves the reviewed actionlint release instead of trusting whatever binary is
# on PATH. The composite action is checked by actionlint through its `uses:`
# reference; actionlint does not accept an action.yml argument.
ACTIONLINT ?= github.com/rhysd/actionlint/cmd/actionlint@v1.7.12
actionlint:
	files="$$(find .github/workflows -type f \( -name '*.yml' -o -name '*.yaml' \) | LC_ALL=C sort)"; \
	[ -n "$$files" ] || { echo "actionlint: no workflow file under .github/workflows" >&2; exit 1; }; \
	$(GO) run $(ACTIONLINT) $$files

# The tracked hook runs `make validate` before a push and refuses a direct
# push to main. std/repos.yaml declares only the governance group for this
# repository, so genguides does not render the hook yet; it was rendered from
# the platform template at the pin and hook-check proves it is the configured,
# executable render. The platform registry must add "hook" to the status entry
# before governance-check can verify its body byte for byte.
hook:
	git config --local core.hooksPath .githooks

hook-check:
	@test -x .githooks/pre-push || { echo "hook-check: .githooks/pre-push is missing or not executable" >&2; exit 1; }
	@grep -q '^# Generated by cmd/genguides from SBK-Techno/platform/guides/pre-push.sh.tmpl\.' .githooks/pre-push || { echo "hook-check: .githooks/pre-push does not carry the generated header" >&2; exit 1; }
	@test "$$(git config --get core.hooksPath || true)" = .githooks || { echo "hook-check: core.hooksPath is not .githooks; run make hook" >&2; exit 1; }

hooks: hook

brand-check: toolchain-check
	python3 scripts/check_generated.py --root "$(STATUS_ROOT)" --platform "$(PLATFORM_DIR)" --brand "$(BRAND_DIR)"

render:
	python3 scripts/build_site.py --root "$(STATUS_ROOT)" --write

render-check:
	python3 scripts/build_site.py --root "$(STATUS_ROOT)" --check

# The platform owns the artifact layout, and its deploy validator owns the
# published file set. `artifact` is the one entry point that writes the exact
# tree `scripts/deploy/status.sh --dist` consumes; it never writes status.json,
# which the publisher serves beside the release.
DIST ?= $(STATUS_ROOT)/dist

artifact: toolchain-check brand
	python3 scripts/artifact_build.py --root "$(STATUS_ROOT)" --out "$(DIST)" --platform "$(PLATFORM_DIR)"

artifact-check: toolchain-check
	python3 scripts/artifact_build.py --root "$(STATUS_ROOT)" --check --platform "$(PLATFORM_DIR)"

# Local browser gate, not part of `make validate`: it needs Playwright and a
# Chromium download, which CI deliberately does not install.
cls-check:
	python3 scripts/cls_check.py --root "$(STATUS_ROOT)"

prune:
	python3 scripts/prune_assets.py --root "$(STATUS_ROOT)" --write

assets-check:
	python3 scripts/prune_assets.py --root "$(STATUS_ROOT)" --check

statuscheck: toolchain-check
	cd "$(PLATFORM_DIR)" && $(GO) run ./cmd/statuscheck -file "$(STATUS_ROOT)/status.json"

lint: toolchain-check
	cd "$(PLATFORM_DIR)" && $(GO) run ./cmd/brandlint -root "$(PLATFORM_DIR)" -brand "$(BRAND_DIR)" -status "$(STATUS_ROOT)"

# Verify the deployed origin against the committed build. This is a
# post-deploy step, not a commit gate: it needs the network and the live site,
# so run it locally after the platform edge deploy.
verify-published: toolchain-check
	@test -n "$(URL)" || { echo "verify-published: set URL to the deployed status origin" >&2; exit 2; }
	python3 scripts/verify_published.py --root "$(STATUS_ROOT)" --url "$(URL)" $(VERIFY_PUBLISHED_FLAGS)

validate: $(GATE_TARGETS)
