#!/usr/bin/env bash
# Generated by cmd/genguides from SBK-Techno/platform/guides/pre-push.sh.tmpl.
# DO NOT EDIT. Install with `make hooks`.
#
# On GitHub Free, private repositories cannot enforce rulesets. This local hook
# blocks a direct push to the default branch, refuses a namespace it cannot
# verify, and runs the repository gate that this checkout owns.
#
# Every push runs `make validate` when this repository owns that target, after
# the ref checks. A direct push to the default branch is refused unless
# SBK_ALLOW_MAIN_PUSH=1.
#
# SBK_SKIP_VALIDATE=<reason> skips the gate deliberately. Every bypass appends
# one line to <git-common-dir>/sbk-gate/bypass.log and prints it. A bypass that
# cannot be logged is refused. `git push --no-verify` does not run this hook at
# all, so CI and the server-side ruleset remain the backstop.

set -Eeuo pipefail

zero=0000000000000000000000000000000000000000
blocked=0
main_pushed=0
refs=()
commits=()

while read -r _local_ref local_sha remote_ref _remote_sha; do
	[[ -n $remote_ref ]] || continue
	refs+=("$remote_ref@$local_sha")
	case $remote_ref in
	refs/heads/main | refs/heads/master)
		main_pushed=1
		if [[ ${SBK_ALLOW_MAIN_PUSH:-0} != 1 ]]; then
			printf 'direct push to %s is blocked; push a branch and open a pull request\n' \
				"$remote_ref" >&2
			blocked=1
		fi
		;;
	esac
	[[ $local_sha == "$zero" ]] && continue
	case $remote_ref in
	refs/heads/* | refs/tags/* | refs/notes/*)
		commits+=("$local_sha")
		;;
	*)
		printf 'pre-push: refusing %s: only refs/heads, refs/tags, and refs/notes are verified\n' \
			"$remote_ref" >&2
		blocked=1
		;;
	esac
done
((blocked == 0)) || exit 1

# log_bypass KIND VARIABLE REASON prints the log path on success. It fails when
# the record cannot be written: a silent bypass is the failure this hook exists
# to prevent.
log_bypass() {
	local kind=$1 variable=$2 reason=$3
	local common dir log user now
	common=$(git rev-parse --path-format=absolute --git-common-dir) || return 1
	dir=$common/sbk-gate
	mkdir -p "$dir" || return 1
	log=$dir/bypass.log
	user=$(id -un 2>/dev/null || printf '%s' "${USER:-unknown}")
	now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
	reason=${reason//$'\t'/ }
	reason=${reason//$'\r'/ }
	reason=${reason//$'\n'/ }
	printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
		"$now" "$user" "$kind" "$variable" "$reason" "${refs[*]:-}" >>"$log" || return 1
	printf '%s\n' "$log"
}

if ((main_pushed == 1)); then
	if ! log=$(log_bypass main-push SBK_ALLOW_MAIN_PUSH "${SBK_ALLOW_MAIN_PUSH}"); then
		printf 'pre-push: cannot record the main-push bypass; refusing\n' >&2
		exit 1
	fi
	printf 'pre-push: bypass main-push: SBK_ALLOW_MAIN_PUSH=%s; recorded in %s\n' \
		"${SBK_ALLOW_MAIN_PUSH}" "$log" >&2
fi

if [[ -n ${SBK_SKIP_VALIDATE:-} && ${SBK_SKIP_VALIDATE} != 0 ]]; then
	if ! log=$(log_bypass validate SBK_SKIP_VALIDATE "$SBK_SKIP_VALIDATE"); then
		printf 'pre-push: cannot record the bypass; refusing\n' >&2
		exit 1
	fi
	printf 'pre-push: bypass validate: SBK_SKIP_VALIDATE=%s; recorded in %s\n' \
		"$SBK_SKIP_VALIDATE" "$log" >&2
	exit 0
fi

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root"
if [[ -f Makefile ]] && grep -q '^validate:' Makefile; then
	make validate
fi

